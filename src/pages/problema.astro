---
import Layout from "../layouts/Layout.astro";
import { phases } from "../data/schedule";

const pregunta =
  "¿Cómo diseñar un agente de acompañamiento que sostenga la constancia y la interiorización del aprendizaje autónomo ante motivaciones diversas, sin depender de notas ni de credenciales vacías?";

const fallas = [
  {
    title: "Información sin red",
    text: "Cursos masivos, LMS y chatbots entregan contenido o respuestas. Casi ninguno acompaña cuando la motivación baja. Demasiada información y demasiado poco con quien sostener el ritmo: se abandona, venga la persona con fuego interno o por obligación.",
  },
  {
    title: "Constancia tratada como rasgo",
    text: "Se asume que «el que quiere, puede». Poco se diseña para sostenerla —andamiaje, entorno seguro, espacio para interiorizar— cuando la motivación no es alta o no es intrínseca.",
  },
  {
    title: "Credenciales en lugar de uso",
    text: "Certificados y rutina laboral premian haber pasado, no poder hacer. Lo aprendido queda enunciable y no se usa: conocimiento inerte con otro nombre.",
  },
  {
    title: "Cómo se manifiesta",
    text: "El aprendizaje se siente trámite —interfaces que no se habitan— y el progreso es opaco: no se ve qué ya se sabe, qué falta ni dónde atajar sin empezar de cero.",
  },
];

const roots = [
  {
    from: "Soledad técnica / abandono",
    to: "Acompañamiento cuando la constancia falla",
  },
  {
    from: "Mascota / agente con quien hablar",
    to: "Presencia interactiva que sostiene el ritmo",
  },
  {
    from: "Animación, personalización, asociación",
    to: "Entorno habitable; vínculos que hacen “clic”",
  },
  {
    from: "Certificados vacíos + trabajo sin crecimiento",
    to: "Interiorización, criterio de dominio, capacidad de hacer",
  },
];

const hypotheses = [
  {
    title: "Árbol y grafo como espejos",
    body: "Las temáticas se alinean entre grafo (verdad) y árbol (progreso). Los nodos de personalización solo vinculan —no cambian el currículum—. Los atajos se ganan con pruebas de desempeño: avance en el grafo, no nota.",
  },
  {
    title: "Compañía sin historial completo",
    body: "Memoria de intereses, plantillas de personalidad y privacidad. Pregunta abierta: ¿qué mínimo de memoria basta para sentir presencia?",
  },
  {
    title: "Adaptación del lenguaje",
    body: "Personalidad, preferencias y asociaciones adaptan la forma de explicar sin tocar el núcleo. Varios mecanismos posibles; no un solo parámetro.",
  },
  {
    title: "Interiorización y buen uso",
    body: "Propósito de la semilla: interiorizar la técnica. El estándar de buen uso se limita a ese dominio —qué se necesita y en qué casos—. La transformación vital es horizonte, no feature de ahora.",
  },
  {
    title: "Espacio seguro y logro",
    body: "Prueba de desempeño acordada con el usuario. Lo conversacional construye un espacio sin prisa donde errar está permitido: confianza que desincentiva la trampa, no vigilancia.",
  },
];

const recorteSi = [
  "Aprendizaje autónomo en dominios técnicos; primer laboratorio: programación (Stitch Code).",
  "Quien quiere dominar la técnica y quien está obligado a aprenderla.",
  "Acompañamiento que sostiene constancia e interiorización —no sustituye al docente.",
  "Criterio sin nota ni credencial vacía.",
];

const recorteNo = [
  "Plataforma de certificados / LMS completo.",
  "Evaluación masiva.",
  "Agente asistente general de vida.",
  "Macro de carrera / narrativa multi-curso como producto (queda como horizonte).",
  "Producto comercial de Stitch Code sin marco de investigación.",
];

const semestreSi = [
  "Fundamentar el problema con lectura (abandono, constancia, tutoría, motivación diversa).",
  "Explorar grafo y árbol; pruebas de desempeño → avance, no nota.",
  "Memoria selectiva y personalidades, con privacidad primero.",
  "Arquitectura conceptual y prototipo pequeño (Stitch Code como vehículo).",
  "Sitio vivo que documenta la evolución.",
];
---

<Layout
  title="El problema — Proyecto Stitch"
  description="Abandono, constancia e interiorización: el problema que investiga el Proyecto Stitch y su pregunta de investigación."
  active="problema"
>
  <main class="bg-paper">
    <section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 pt-28 pb-20 sm:px-8 sm:pt-36 sm:pb-28 md:pt-40">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          El problema
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-3xl font-semibold text-ink sm:text-4xl md:text-5xl">
          Querer aprender no alcanza
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Las personas abandonan el aprendizaje técnico —vengan con motivación fuerte o por obligación—
          porque enfrentan demasiada información y demasiado poco acompañamiento para sostener la constancia,
          bajo sistemas que premian certificados en lugar de interiorización real.
        </p>
        <div class="mt-10 max-w-2xl">
          <h2 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
            Pregunta de investigación
          </h2>
          <p class="mt-3 text-base leading-relaxed text-ink italic sm:text-lg">
            {pregunta}
          </p>
        </div>
        <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft" aria-label="En esta página">
          <a href="#motivacion" class="hover:text-thread">Motivación</a>
          <a href="#problema" class="hover:text-thread">Qué falla</a>
          <a href="#vision" class="hover:text-thread">Visión</a>
          <a href="#preguntas" class="hover:text-thread">Preguntas</a>
          <a href="#alcance" class="hover:text-thread">Alcance</a>
        </nav>
      </div>
    </section>

    <section id="motivacion" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          01 · Motivación
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          De dónde nace esto
        </h2>

        <div class="mt-12 max-w-2xl space-y-6 text-base leading-relaxed text-ink-soft sm:text-lg">
          <p>
            Parte de mi historia es la curiosidad: me tomo el tiempo de investigar lo que me interesa.
            El choque llegó al pasar al lado técnico —demasiadas fuentes, muy poco acompañamiento, y al final desistir—.
            Ahí entendí que{" "}
            <strong class="font-semibold text-ink">querer aprender no alcanza</strong>
            {" "}si no hay forma de sostener el proceso.
          </p>
          <p class="border-l-2 border-signal pl-5 text-ink">
            Cuando quise aprender a programar, empecé un curso de Java y no terminé asociando los conceptos.
            No fue hasta una app de Python ligada a un juego que verdaderamente pude avanzar.
            Misma intención; distinta forma de vincular el conocimiento con algo mío.
          </p>
          <p>
            También cargo la idea de un agente tipo mascota —alguien con quien hablar, no un menú frío—
            y la búsqueda de un espacio habitable: animación, interactividad, personalización.
          </p>
          <p>
            Eso me pasó a mí. El problema que investigo no es la anécdota: es lo que enseña cuando le ocurre a
            cualquiera —quien quiere dominar la técnica y quien está obligado a aprenderla—.
          </p>
        </div>

        <h3 class="mt-16 font-display text-xl font-semibold text-ink">De dónde sale Stitch</h3>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {
            roots.map((row) => (
              <li class="grid gap-2 py-5 sm:grid-cols-2 sm:gap-8">
                <p class="text-sm text-ink-soft">{row.from}</p>
                <p class="font-medium text-ink">{row.to}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 max-w-2xl text-base leading-relaxed text-ink-soft">
          <strong class="font-semibold text-ink">Stitch Code</strong> es el primer laboratorio (programación).{" "}
          <strong class="font-semibold text-ink">Stitch</strong> es el marco: cómo diseñar ese acompañamiento más allá de un dominio.
          El vocabulario de trabajo está en el{" "}
          <a href="/grafo" class="text-ink underline decoration-thread/50 underline-offset-4 hover:text-thread">grafo</a>;
          las lecturas que lo van anclando, en{" "}
          <a href="/lecturas" class="text-ink underline decoration-thread/50 underline-offset-4 hover:text-thread">lecturas</a>.
        </p>
      </div>
    </section>

    <section id="problema" class="border-b border-line bg-paper-deep/50">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          02 · Qué falla hoy
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          No es falta de contenido
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          El curso masivo entrega material. El LMS registra actividad. El chatbot responde.
          El certificado acredita el paso. Casi ninguno sostiene el proceso cuando la motivación baja,
          ni comprueba que lo aprendido se pueda usar.
        </p>

        <ol class="mt-14 grid gap-10 sm:grid-cols-2">
          {
            fallas.map((item, i) => (
              <li>
                <span class="font-display text-sm font-semibold text-signal">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-2 font-display text-xl font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-ink-soft">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="vision" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          03 · Visión
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Horizonte y semilla
        </h2>

        <div class="mt-12 grid gap-12 lg:grid-cols-2">
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-signal uppercase">
              Horizonte
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">
              Transformación personal; más adelante, narrativa entre cursos y un macro del proceso
              que pueda orientar una carrera. Orienta el porqué;{" "}
              <strong class="font-semibold text-ink">no es el entregable ahora</strong>.
            </p>
          </div>
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-thread uppercase">
              Semilla
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-soft sm:text-lg">
              Interiorizar conocimiento con acompañamiento; sostener constancia ante motivaciones distintas.
              El progreso visible y el criterio de buen uso del dominio son vías, no un segundo problema.
            </p>
          </div>
        </div>

        <div class="mt-16 max-w-3xl border-t border-line pt-10">
          <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
            Hipótesis central
          </h3>
          <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">
            Si el aprendizaje se sostiene con un agente de acompañamiento —cercano, capaz de trabajar la constancia
            ante motivaciones diversas—, <strong class="font-semibold text-ink">mediante</strong> un mapa del progreso
            ligado a conocimiento veraz y una personalización del lenguaje que no toca el núcleo, la persona puede
            pasar de empezar a interiorizar y sostener el dominio que estudia, sin depender de certificados vacíos.
            El crecimiento inmediato se mide en constancia e interiorización; la transformación vital queda como horizonte.
          </p>
        </div>
      </div>
    </section>

    <section id="preguntas" class="border-b border-line bg-paper-deep/50">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          04 · Preguntas
        </p>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Qué investigamos este semestre
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          La pregunta general ya está arriba. Estas cuatro la descomponen. Contaría como respuesta,
          este semestre, un prototipo pequeño en Stitch Code y evidencia acotada de que el acompañamiento
          ayuda a seguir y a usar lo aprendido —no a acumular notas.
        </p>

        <ol class="mt-14 grid gap-10 sm:grid-cols-2">
          {
            phases.map((phase, i) => (
              <li>
                <span class="font-display text-xs font-semibold tracking-wide text-thread uppercase">
                  {phase.short}
                </span>
                <p class="mt-2 font-display text-lg font-semibold leading-snug text-ink">
                  {phase.question}
                </p>
                <span class="mt-2 block font-display text-sm text-mist">{String(i + 1).padStart(2, "0")}</span>
              </li>
            ))
          }
        </ol>

        <div class="mt-20">
          <h3 class="font-display text-xl font-semibold text-ink sm:text-2xl">
            Hipótesis de diseño (preliminares)
          </h3>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">
            El «mediante» de la hipótesis central. No están validadas: son semilla, no conclusión.
          </p>
          <ul class="mt-10 space-y-8 max-w-3xl">
            {
              hypotheses.map((h, i) => (
                <li class="border-l-2 border-line pl-5">
                  <p class="font-display text-sm font-semibold text-signal">
                    {String(i + 1).padStart(2, "0")} · {h.title}
                  </p>
                  <p class="mt-2 text-base leading-relaxed text-ink-soft">{h.body}</p>
                </li>
              ))
            }
          </ul>
          <p class="mt-10 text-sm text-ink-soft">
            Prioridad orientativa: (1) pruebas de desempeño → avance en el grafo ·
            (2) compañía con memoria mínima · (3) el resto como satélites.
          </p>
        </div>
      </div>
    </section>

    <section id="alcance" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          05 · Alcance
        </p>
        <h2 class="mt-4 font-display text-3xl font-semibold text-ink sm:text-4xl">
          Qué cubre la pregunta — y qué se hace ahora
        </h2>

        <div class="mt-12 grid gap-12 lg:grid-cols-2">
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-thread uppercase">
              Recorte de la pregunta
            </h3>
            <ul class="mt-5 space-y-3 text-base leading-relaxed text-ink-soft">
              {recorteSi.map((item) => <li>{item}</li>)}
            </ul>
            <h4 class="mt-10 font-display text-sm font-semibold tracking-wide text-ink-soft uppercase">
              No cubre
            </h4>
            <ul class="mt-5 space-y-3 text-base leading-relaxed text-ink-soft">
              {recorteNo.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
              Este semestre
            </h3>
            <ul class="mt-5 space-y-3 text-base leading-relaxed text-ink-soft">
              {semestreSi.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread-bright uppercase">
          Delimitación · Agosto 2026
        </p>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-mist">
          Esta página es el problema vigente, no el diario de una semana.
          Lo que sigue es dejar que la lectura roce estas hipótesis.
        </p>
        <p class="mt-8 text-sm text-mist/80">
          <a href="/lecturas" class="text-bloom underline decoration-bloom/40 underline-offset-4 hover:text-paper">Lecturas</a>
          <span class="mx-2 text-mist/50">·</span>
          <a href="/grafo" class="text-bloom underline decoration-bloom/40 underline-offset-4 hover:text-paper">Grafo</a>
        </p>
      </div>
    </section>
  </main>
</Layout>

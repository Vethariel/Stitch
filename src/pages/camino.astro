---
import Layout from "../layouts/Layout.astro";
import CaminoDiagram from "../components/CaminoDiagram";
import { caminoMeta, caminoNorth, caminoOrigin } from "../data/camino";
import { bridgeNote } from "../data/marcoCaminoBridge";
---

<Layout
  title="Camino — Proyecto Stitch"
  description="De Stitch Code al norte: aspectos a pulir y cruce con el marco del compañero."
  active="camino"
>
  <main class="bg-paper">
    <section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 pt-28 pb-16 sm:px-8 sm:pt-36 sm:pb-20 md:pt-40">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Investigación · {caminoMeta.label}
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-3xl font-semibold text-ink sm:text-4xl md:text-5xl">
          Camino
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          {caminoMeta.blurb}
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
          {bridgeNote}{" "}
          <a
            href="/marco"
            class="text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            Ver el marco →
          </a>
        </p>
        <p class="mt-4 max-w-2xl text-sm text-ink-soft">
          <span class="font-medium text-ink">{caminoOrigin.short}</span>
          (Stitch Code: Woven + Hilo) → Stitch (aspectos a pulir) →
          <span class="font-medium text-ink">{caminoNorth.short}</span>.
          Clic en un nodo para leer; el origen ya es laboratorio real.
        </p>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-6xl px-5 pt-12 pb-28 sm:px-8 sm:pt-16 sm:pb-40">
        <CaminoDiagram client:load />
      </div>
    </section>
  </main>
</Layout>

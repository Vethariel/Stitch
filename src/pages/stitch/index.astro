---
import Layout from "../../layouts/Layout.astro";
import ViasGraph from "../../components/ViasGraph";
import { stitchMeta, stitchNorte, stitchProblema } from "../../data/stitch";
import { faseActual, versionadoReglas, viaVigente, vias } from "../../data/versiones";

const cuadros = vias.map((v) => ({ ...v, vigente: viaVigente(v.id) }));
---

<Layout
  title="Stitch — Proyecto Stitch"
  description="Stitch, el compañero de aprendizaje autónomo: qué ataca, su norte y sus tres vías (marco, modelo y sistema) versionadas."
  active="stitch"
>
  <main class="bg-paper">
    <section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 pt-28 pb-16 sm:px-8 sm:pt-36 sm:pb-20 md:pt-40">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Investigación · versión {faseActual.version}
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-3xl font-semibold text-ink sm:text-4xl md:text-5xl">
          {stitchMeta.label}
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          {stitchMeta.blurb}
        </p>
        <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft" aria-label="En esta página">
          <a href="#problema" class="hover:text-thread">Problema</a>
          <a href="#norte" class="hover:text-thread">Norte</a>
          <a href="#vias" class="hover:text-thread">Tres vías</a>
        </nav>
      </div>
    </section>

    <section id="problema" class="scroll-mt-20 border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          01 · Problema
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Qué ataca Stitch
        </h2>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          {stitchProblema.resumen}
        </p>
        <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {
            stitchProblema.ataca.map((item, i) => (
              <li>
                <span class="font-display text-sm font-semibold text-signal-ink">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-2 font-display text-xl font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-ink-soft">{item.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="mt-14 text-sm text-ink-soft">
          Pregunta de investigación, motivación, fallas, hipótesis y alcance en{" "}
          <a
            href="/problema"
            class="text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            Problema
          </a>
          .
        </p>
      </div>
    </section>

    <section id="norte" class="scroll-mt-20 border-b border-line bg-paper-deep/50">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          02 · Norte
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          {stitchNorte.title}
        </h2>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          {stitchNorte.body}
        </p>
        <div class="mt-12 grid gap-10 sm:grid-cols-2">
          {
            stitchNorte.principles.map((p) => (
              <div class="border-l-2 border-thread/40 pl-5">
                <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
                  {p.title}
                </h3>
                <p class="mt-2 text-base leading-relaxed text-ink-soft">{p.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="vias" class="scroll-mt-20">
      <div class="mx-auto max-w-6xl px-5 pt-20 pb-28 sm:px-8 sm:pt-28 sm:pb-40">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          03 · Tres vías
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Marco, modelo y sistema
        </h2>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {
            cuadros.map((v) => (
              <a
                href={`/stitch/${v.id}`}
                class="group flex flex-col border border-line bg-paper-deep/30 p-6 transition-colors hover:border-thread/60"
              >
                <p class="font-display text-xs font-semibold tracking-[0.18em] text-thread uppercase">
                  {v.pregunta}
                </p>
                <h3 class="mt-2 font-display text-2xl font-semibold text-ink group-hover:text-thread">
                  {v.label} <span class="text-ink-soft">· v{v.vigente?.n}</span>
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{v.definicion}</p>
                <p class="mt-5 text-sm font-medium text-thread">Ver detalle →</p>
              </a>
            ))
          }
        </div>

        <div class="mt-14">
          <ViasGraph client:load />
        </div>

        <details class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-soft">
          <summary class="cursor-pointer font-medium text-ink hover:text-thread">Cómo se versiona</summary>
          <p class="mt-3">{versionadoReglas.formato}</p>
          <p class="mt-2">{versionadoReglas.cascada}</p>
          <p class="mt-2">{versionadoReglas.historial}</p>
        </details>
      </div>
    </section>
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import HeroVisual from "../components/HeroVisual.astro";

const pregunta =
  "¿Cómo diseñar un agente de acompañamiento que sostenga la constancia y la interiorización del aprendizaje autónomo, de modo que queden conocimiento y habilidades aplicables y el aprendizaje tenga sentido: se usa, se interioriza, y el progreso se siente vivido —no simulado?";

const resumen = [
  {
    title: "Qué ataca",
    text: "Muchas personas abandonan el aprendizaje técnico: hay demasiada información y muy poco acompañamiento para sostener la constancia, y los sistemas premian el certificado más que lo que de verdad queda.",
  },
  {
    title: "Qué hace",
    text: "Acompaña a quien aprende por su cuenta: lee qué entendió y qué no, da la ayuda justa sin resolver por la persona, recuerda lo mínimo entre encuentros y sostiene el ritmo. Se acopla al entorno donde ya se aprende.",
  },
  {
    title: "Hacia dónde va",
    text: "Un norte fijo: que lo aprendido quede y sirva. Poder hacer frente a problemas reales, aprender a aprender, sentir el progreso como vivido y encontrarle sentido propio.",
  },
];

const noEs = [
  "Una plataforma de cursos ni un certificado.",
  "Un sustituto del docente.",
  "Un chatbot que da las respuestas.",
  "Gamificación con puntos o rachas.",
];

const naming = [
  {
    name: "Stitch",
    meaning: "El compañero de aprendizaje con IA, pensado como anexo (/stitch).",
  },
  {
    name: "Tres vías",
    meaning: "Marco (qué debe valer), modelo (cómo se concreta) y sistema (cómo se acopla como anexo), versionadas como marco.modelo.sistema.",
  },
  {
    name: "Stitch Code",
    meaning: "Primer anfitrión del compañero: ingeniería de software.",
  },
  {
    name: "Proyecto Stitch",
    meaning: "Esta investigación y este sitio.",
  },
];

const exists = [
  { href: "/problema", label: "Problema" },
  { href: "/stitch", label: "Stitch (problema, norte, tres vías)" },
  { href: "/lecturas", label: "Lecturas" },
  { href: "/vocabulario", label: "Vocabulario" },
  { href: "/progreso", label: "Progreso" },
];

const progressive = ["Árbol de conocimiento (por capas)", "Bitácora / hechos en /progreso"];

const later = [
  "Visor",
  "Evaluador",
  "Proyecto aplicado",
  "Otras unidades",
  "Docente y comunidad (como diseño)",
];
---

<Layout
  title="Proyecto Stitch — Investigación en curso"
  description="Stitch: un compañero de aprendizaje con IA para quien aprende por su cuenta, pensado como anexo a otros entornos. Research log del semestre 2026."
  active="inicio"
>
  <main>
    <section class="relative isolate min-h-[100svh] overflow-hidden">
      <HeroVisual />
      <div
        class="relative mx-auto flex min-h-[100svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-28 sm:px-8 sm:pb-24 lg:justify-center lg:pb-0"
      >
        <p
          class="animate-fade-up font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase"
        >
          Investigación en curso · Agosto–diciembre 2026
        </p>
        <p
          class="animate-fade-up mt-4 font-display text-6xl font-semibold tracking-tight text-ink sm:text-7xl md:text-8xl"
        >
          Stitch
        </p>
        <h1
          class="animate-fade-up-delay-1 mt-5 max-w-2xl font-display text-2xl font-medium leading-snug text-ink sm:text-3xl md:text-4xl"
        >
          Un compañero de aprendizaje con IA para quien aprende por su cuenta.
        </h1>
        <p
          class="animate-fade-up-delay-2 mt-5 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg"
        >
          Stitch acompaña sin hacer el trabajo por la persona: comprueba qué
          entendió, ajusta cuánta ayuda dar, recuerda lo mínimo para dar
          continuidad y sostiene el ritmo cuando la motivación baja. No es una
          plataforma de cursos: es un{" "}
          <strong class="font-medium text-ink">anexo</strong> que se acopla a un
          entorno de aprendizaje. El primero es Stitch Code, un entorno para
          aprender a programar.
        </p>
        <p class="animate-fade-up-delay-2 mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">
          Este sitio es el registro de la investigación: problema, diseño
          versionado, lecturas y avances. No hay prototipo público todavía.
        </p>
        <div class="animate-fade-up-delay-3 mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm">
          <a
            href="/problema"
            class="font-medium text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            El problema
          </a>
          <a
            href="#que-es"
            class="font-medium text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            En pocas palabras
          </a>
          <a
            href="/stitch"
            class="font-medium text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            Stitch
          </a>
        </div>
      </div>
    </section>

    <section id="que-es" class="scroll-mt-24 border-t border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          En pocas palabras
        </p>
        <h2 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-tight text-ink sm:text-4xl">
          Qué es Stitch
        </h2>
        <div class="mt-12 grid gap-10 md:grid-cols-3">
          {
            resumen.map((item) => (
              <div class="border-l-2 border-thread/40 pl-5">
                <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
                  {item.title}
                </h3>
                <p class="mt-3 text-base leading-relaxed text-ink-soft">{item.text}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-14 max-w-2xl">
          <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
            Qué no es
          </h3>
          <ul class="mt-4 space-y-2 text-base text-ink-soft">
            {noEs.map((item) => <li class="border-l-2 border-line pl-4">{item}</li>)}
          </ul>
        </div>
        <p class="mt-10 text-sm text-ink-soft">
          El norte completo y el estado del diseño en{" "}
          <a
            href="/stitch"
            class="text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            Stitch
          </a>
          .
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-paper-deep/50">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Origen
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          De dónde sale esto
        </h2>
        <div class="mt-8 max-w-2xl space-y-6 text-base leading-relaxed text-ink-soft sm:text-lg">
          <p>
            Como estudiante, a menudo aprendía más por mi cuenta que con la
            mediación que tenía a mano. No era un rechazo a los docentes: a veces
            encontraba buenos; a menudo, cuando la constancia fallaba o el tema no
            «hacía clic», el entorno institucional no sostenía el proceso. Quedaba
            el trámite —clases, entregas, la nota— y, al final, la sensación de
            haber pasado sin haber podido <em>hacer</em>.
          </p>
          <p>
            Esa experiencia se cruzó con lo que veo en cursos en línea y en
            plataformas que prometen dominio: mucho contenido, poco acompañamiento,
            y un cierre en credencial que ya no garantiza nada. La pregunta que
            quedó no fue «cómo enseñar más rápido», sino cómo diseñar presencia
            para quien aprende por su cuenta —sin fingir ser el profesor, sin
            vender otro certificado vacío.
          </p>
          <p>
            De ahí nace Stitch. Quiero un diseño donde el viaje pueda variar
            (ritmo, intereses, modo abierto o aula, incluso el dominio) y el
            destino sea el mismo: que lo aprendido se interiorice, se use en los
            problemas que importan, y que el tiempo no se pierda fingiendo
            progreso. El compañero y sus tres vías —marco, modelo y sistema— son
            piezas de esa búsqueda —aún en curso, sin prototipo que vender.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Nombres
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Cómo nombrar las piezas
        </h2>
        <div class="mt-10 overflow-x-auto">
          <table class="w-full min-w-[480px] border-collapse text-left text-sm sm:text-base">
            <thead>
              <tr class="border-b border-line">
                <th class="py-3 pr-6 font-display font-semibold text-ink">Nombre</th>
                <th class="py-3 font-display font-semibold text-ink">Aquí</th>
              </tr>
            </thead>
            <tbody class="text-ink-soft">
              {
                naming.map((row) => (
                  <tr class="border-b border-line/70">
                    <td class="py-3.5 pr-6 align-top font-medium text-ink">{row.name}</td>
                    <td class="py-3.5 align-top leading-relaxed">{row.meaning}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="estado" class="scroll-mt-24 border-t border-line bg-paper-deep/50">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Honestidad
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Dónde estamos
        </h2>

        <div class="mt-12 grid gap-10 lg:grid-cols-3">
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-thread uppercase">
              Existe y se puede leer
            </h3>
            <ul class="mt-4 space-y-2 text-base text-ink-soft">
              {
                exists.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-ink underline decoration-thread/30 underline-offset-4 hover:text-thread"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
              En construcción / progresivo
            </h3>
            <ul class="mt-4 space-y-2 text-base text-ink-soft">
              {progressive.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
              Visión larga, no este semestre
            </h3>
            <ul class="mt-4 space-y-2 text-base text-ink-soft">
              {later.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>

        <p class="mt-12 max-w-2xl text-base leading-relaxed text-ink-soft">
          Las tres vías muestran en qué estado está cada pieza, desde Stitch Code,
          el primer anfitrión, hasta el norte. El trabajo de este semestre apunta al{" "}
          <strong class="font-medium text-ink">compañero</strong> y a pulir sus
          aspectos — siempre con el norte de arriba, no con la promesa de
          entregar todo el sistema.
        </p>
      </div>
    </section>

    <section class="border-t border-line bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Ancla
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Pregunta de investigación
        </h2>
        <p class="mt-8 max-w-3xl font-display text-xl leading-snug text-ink italic sm:text-2xl">
          {pregunta}
        </p>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft">
          Que quede lo aplicable, y que el camino tenga sentido: se usa, se
          interioriza, y el progreso se siente vivido —no simulado.
        </p>
        <p class="mt-8 text-sm text-ink-soft">
          Detalle en{" "}
          <a
            href="/problema"
            class="text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            Problema
          </a>
          · el compañero y sus tres vías en{" "}
          <a
            href="/stitch"
            class="text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
          >
            Stitch
          </a>
          .
        </p>
      </div>
    </section>

    <section class="border-t border-ink/20 bg-ink text-paper">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
        <p class="font-display text-lg font-semibold sm:text-xl">
          El viaje cambia; el destino no: interiorizar, aplicar, no perder el
          tiempo.
        </p>
        <p class="mt-4 text-sm text-mist">
          Proyecto Stitch — research log · semestre 2026
        </p>
      </div>
    </section>
  </main>
</Layout>

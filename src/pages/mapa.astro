---
import Layout from "../layouts/Layout.astro";
import SystemMapDiagram from "../components/SystemMapDiagram";
import { companionMeta } from "../data/companionThemes";
---

<Layout
  title="Mapa del sistema — Proyecto Stitch"
  description="Mapa del compañero Stitch: temas de indagación pedagógica e hipótesis técnicas."
  active="mapa"
>
  <main class="bg-paper">
    <section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 pt-28 pb-16 sm:px-8 sm:pt-36 sm:pb-20 md:pt-40">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Sistema · {companionMeta.label}
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-3xl font-semibold text-ink sm:text-4xl md:text-5xl">
          Mapa del sistema
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Grafo de la foto finish: por ahora el compañero y los temas que abre.
          Clic en un tema → lado pedagógico y lado técnico.
        </p>
        <p class="mt-4 max-w-2xl text-sm text-ink-soft italic">
          {companionMeta.thread}
        </p>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-6xl px-5 pt-12 pb-28 sm:px-8 sm:pt-16 sm:pb-40">
        <SystemMapDiagram client:load />
      </div>
    </section>
  </main>
</Layout>

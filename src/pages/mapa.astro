---
import Layout from "../layouts/Layout.astro";
import SystemMapDiagram from "../components/SystemMapDiagram";
import {
  entities,
  hierarchy,
  implementationLine,
  outOfScope,
  phaseLabels,
  relations,
  scaleEntities,
  systemMapMeta,
} from "../data/systemMap";
---

<Layout
  title="Mapa del sistema — Proyecto Stitch"
  description="Foto finish del sistema Stitch: entidades, relaciones, escala y línea de implementación."
  active="mapa"
>
  <main class="bg-paper">
    <section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 pt-28 pb-20 sm:px-8 sm:pt-36 sm:pb-28 md:pt-40">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          Arquitectura · {systemMapMeta.label}
        </p>
        <h1 class="mt-5 max-w-3xl font-display text-3xl font-semibold text-ink sm:text-4xl md:text-5xl">
          Mapa del sistema
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft sm:text-lg">
          Foto finish del sistema dentro de una <strong class="font-medium text-ink">unidad</strong> (curso)
          y su encadenamiento en <strong class="font-medium text-ink">ruta</strong>.
          La investigación arranca por <strong class="font-medium text-ink">Stitch</strong> (compañero);
          visor, evaluador y proyecto son fases posteriores.
        </p>
        <p class="mt-4 max-w-2xl text-sm text-ink-soft">
          Actualizado {systemMapMeta.version} · Documento extendido en{" "}
          <code class="text-thread">docs/mapa-del-sistema.md</code>
        </p>
        <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft" aria-label="En esta página">
          <a href="#diagrama" class="hover:text-thread">Diagrama</a>
          <a href="#jerarquia" class="hover:text-thread">Jerarquía</a>
          <a href="#entidades" class="hover:text-thread">Entidades</a>
          <a href="#relaciones" class="hover:text-thread">Relaciones</a>
          <a href="#escala" class="hover:text-thread">Escala</a>
          <a href="#implementacion" class="hover:text-thread">Implementación</a>
        </nav>
      </div>
    </section>

    <section id="diagrama" class="border-b border-line bg-paper-deep/30">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          01 · Vista general
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Diagrama del mapa
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
          Siete entidades dentro de una unidad; arriba, la ruta que concatena cursos.
          Haz clic en un nodo para resaltar sus conexiones o salta a su descripción.
        </p>
        <div class="mt-12">
          <SystemMapDiagram client:load />
        </div>
      </div>
    </section>

    <section id="jerarquia" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          02 · Jerarquía
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          No todas las entidades pesan igual
        </h2>
        <p class="mt-5 max-w-2xl text-sm text-ink-soft">
          <em>Central</em> no es lo mismo que <em>más importante</em>: el árbol organiza el sistema;
          el estudiante es quien le da sentido.
        </p>
        <div class="mt-10 overflow-x-auto">
          <table class="w-full min-w-[520px] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-line">
                <th class="py-3 pr-4 font-display font-semibold text-ink">Rol</th>
                <th class="py-3 pr-4 font-display font-semibold text-ink">Entidad</th>
                <th class="py-3 font-display font-semibold text-ink">Qué significa</th>
              </tr>
            </thead>
            <tbody class="text-ink-soft">
              {hierarchy.map((row) => (
                <tr class="border-b border-line/70">
                  <td class="py-3 pr-4 align-top">{row.role}</td>
                  <td class="py-3 pr-4 align-top font-medium text-ink">{row.entity}</td>
                  <td class="py-3 align-top leading-relaxed">{row.meaning}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="entidades" class="border-b border-line bg-paper-deep/30">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          03 · Entidades
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Responsabilidades en detalle
        </h2>

        <div class="mt-14 space-y-20">
          {entities.map((entity) => (
            <article id={entity.id} class="scroll-mt-28 border-t border-line pt-14 first:border-t-0 first:pt-0">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
                <h3 class="font-display text-2xl font-semibold text-ink sm:text-3xl">
                  {entity.label}
                  {entity.alias && (
                    <span class="text-thread"> · {entity.alias}</span>
                  )}
                </h3>
                <span class="rounded-full border border-line bg-paper px-3 py-0.5 font-display text-xs font-semibold tracking-wide text-ink-soft uppercase">
                  {phaseLabels[entity.phase]}
                </span>
              </div>
              {entity.hierarchy && (
                <p class="mt-2 font-display text-sm text-thread">{entity.hierarchy}</p>
              )}
              <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">
                <span class="font-medium text-ink">Potestad:</span> {entity.potency}
              </p>
              <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">
                {entity.summary}
              </p>
              <ul class="mt-6 max-w-3xl space-y-2 text-base leading-relaxed text-ink-soft">
                {entity.bullets.map((item) => (
                  <li class="border-l-2 border-thread/40 pl-4">{item}</li>
                ))}
              </ul>

              {entity.sections?.map((section) => (
                <div class="mt-8 max-w-3xl">
                  <h4 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
                    {section.title}
                  </h4>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink-soft">
                    {section.items.map((item) => (
                      <li class="pl-4 before:mr-2 before:text-thread before:content-['·']">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}

              {entity.contrasts && entity.contrasts.length > 0 && (
                <div class="mt-8 max-w-3xl overflow-x-auto">
                  <table class="w-full min-w-[400px] border-collapse text-sm">
                    <thead>
                      <tr class="border-b border-line">
                        <th class="py-2 pr-4 text-left font-display font-semibold text-ink">No es</th>
                        <th class="py-2 text-left font-display font-semibold text-ink">Sí es</th>
                      </tr>
                    </thead>
                    <tbody class="text-ink-soft">
                      {entity.contrasts.map((row) => (
                        <tr class="border-b border-line/60">
                          <td class="py-2.5 pr-4 align-top">{row.not}</td>
                          <td class="py-2.5 align-top">{row.is}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {entity.note && (
                <p class="mt-6 max-w-3xl text-sm italic leading-relaxed text-ink-soft">
                  {entity.note}
                </p>
              )}

              {entity.link && (
                <p class="mt-4">
                  <a
                    href={entity.link.href}
                    class="text-sm text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
                  >
                    {entity.link.label} →
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="relaciones" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          04 · Relaciones
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Cómo se conectan las piezas
        </h2>
        <p class="mt-5 max-w-2xl text-sm text-ink-soft">
          Flechas sólidas en el diagrama = flujo principal; líneas punteadas = coordinación sin dependencia estricta.
        </p>
        <div class="mt-10 space-y-6">
          {relations.map((rel) => (
            <div
              class="rounded-lg border border-line bg-paper px-5 py-4 sm:px-6"
              id={`rel-${rel.id}`}
            >
              <p class="font-display text-sm font-semibold text-thread">{rel.label}</p>
              <p class="mt-2 text-base leading-relaxed text-ink-soft">{rel.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="escala" class="border-b border-line bg-paper-deep/30">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          05 · Escala
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          Unidad y ruta
        </h2>
        <div class="mt-10 grid gap-8 lg:grid-cols-2">
          {scaleEntities.map((item) => (
            <div class="rounded-xl border border-line bg-paper p-6">
              <h3 class="font-display text-lg font-semibold text-ink">{item.label}</h3>
              <p class="mt-3 text-base leading-relaxed text-ink-soft">{item.summary}</p>
            </div>
          ))}
        </div>

        <h3 class="mt-14 font-display text-sm font-semibold tracking-wide text-ink uppercase">
          Fuera de alcance (nombradas en la foto finish)
        </h3>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {outOfScope.map((item) => (
            <div class="rounded-lg border border-dashed border-line px-5 py-4">
              <p class="font-display font-semibold text-ink">{item.label}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.summary}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="implementacion">
      <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
        <p class="font-display text-xs font-semibold tracking-[0.2em] text-thread uppercase">
          06 · Laboratorio
        </p>
        <h2 class="mt-4 max-w-2xl font-display text-3xl font-semibold text-ink sm:text-4xl">
          {implementationLine.title}
        </h2>
        <div class="mt-10 grid gap-8 lg:grid-cols-2">
          <div class="rounded-xl border border-thread/30 bg-paper-deep/40 p-6">
            <h3 class="font-display text-sm font-semibold tracking-wide text-thread uppercase">
              Ahora
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">
              {implementationLine.now}
            </p>
          </div>
          <div class="rounded-xl border border-line bg-paper p-6">
            <h3 class="font-display text-sm font-semibold tracking-wide text-ink uppercase">
              Horizonte
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">
              {implementationLine.horizon}
            </p>
          </div>
        </div>
        <p class="mt-10 max-w-2xl text-sm text-ink-soft">
          Pregunta de investigación que atraviesa el mapa:{" "}
          <em class="text-ink">{systemMapMeta.question}</em> — detalle en{" "}
          <a href="/problema" class="text-thread underline decoration-thread/40 underline-offset-4">
            Problema
          </a>{" "}
          y criterios del compañero en{" "}
          <a href="/marco" class="text-thread underline decoration-thread/40 underline-offset-4">
            Marco
          </a>.
        </p>
      </div>
    </section>
  </main>
</Layout>

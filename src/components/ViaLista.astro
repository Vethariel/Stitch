---
import { anclaObjeto, conexionesDe, vias, type Conexion, type Via } from "../data/versiones";

export type ViaItem = {
  id: string;
  title: string;
  descripcion: string;
  detalle?: { label: string; text: string };
  /** Sin items se muestra como pendiente. */
  fuentes?: { label: string; items: { label: string; href: string }[] };
  grupo?: string;
};

interface Props {
  via: Via;
  items: ViaItem[];
}

const { via, items } = Astro.props;
const viaLabel = Object.fromEntries(vias.map((v) => [v.id, v.label])) as Record<Via, string>;

const grupos: { titulo?: string; items: (ViaItem & { n: number; conexiones: Conexion[] })[] }[] = [];
items.forEach((item, i) => {
  const actual = grupos[grupos.length - 1];
  if (!actual || actual.titulo !== item.grupo) grupos.push({ titulo: item.grupo, items: [] });
  grupos[grupos.length - 1].items.push({ ...item, n: i + 1, conexiones: conexionesDe(via, item.id) });
});---

<section>
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    {
      grupos.map((g) => (
        <div class="mt-14 first:mt-0">
          {g.titulo && (
            <h2 class="font-display text-sm font-semibold tracking-[0.18em] text-thread uppercase">
              {g.titulo}
            </h2>
          )}
          <ol class:list={["max-w-3xl divide-y divide-line", g.titulo && "mt-4"]}>
            {g.items.map((item) => (
              <li
                id={anclaObjeto({ via, id: item.id })}
                class="scroll-mt-24 py-7 target:border-l-4 target:border-l-signal target:pl-5"
              >
                <p class="font-display text-xs font-semibold text-signal">
                  {String(item.n).padStart(2, "0")}
                </p>
                <h3 class="mt-1 font-display text-xl font-semibold text-ink">{item.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-ink-soft">{item.descripcion}</p>
                {item.detalle && (
                  <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                    <span class="font-medium text-ink">{item.detalle.label}:</span> {item.detalle.text}
                  </p>
                )}
                {item.fuentes && (
                  <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm leading-relaxed text-ink-soft">
                    <span class="font-medium text-ink">{item.fuentes.label}:</span>
                    {item.fuentes.items.length > 0 ? (
                      item.fuentes.items.map((f) => (
                        <a
                          href={f.href}
                          class="text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
                        >
                          {f.label}
                        </a>
                      ))
                    ) : (
                      <span class="italic text-ink-soft/80">pendiente</span>
                    )}
                  </p>
                )}
                {item.conexiones.length > 0 && (
                  <ul class="mt-4 space-y-1.5 border-l-2 border-line pl-4 text-sm leading-relaxed">
                    {item.conexiones.map((c) => (
                      <li class="text-ink-soft">
                        <span class="font-display font-semibold text-ink">{viaLabel[c.via]}:</span>{" "}
                        <span class:list={[c.tipo === "tension" ? "text-signal" : "text-ink-soft/80"]}>
                          {c.frase}
                        </span>{" "}
                        <a
                          href={c.href}
                          class="font-medium text-thread underline decoration-thread/40 underline-offset-4 hover:text-thread-dim"
                        >
                          {c.label}
                        </a>
                        {c.nota && <span> — {c.nota}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>
